<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="triton_student_cpl_page" name="Capaian CPL Pribadi">
        <t t-call="website.layout"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><main class="o_triton_page o_triton_portal-page"><t t-call="erpobe.triton_portal_nav"/><section class="o_triton_section"><div class="o_triton_container"><header class="o_triton_heading"><div><span class="o_triton_eyebrow">Mahasiswa</span><h1>Capaian CPL pribadi</h1><p class="o_triton_subtitle">Jejak capaian CPL terhadap CPMK dan mata kuliah.</p></div></header><t t-call="erpobe.triton_portal_list_controls"/><div t-if="grades" class="o_triton_table-wrap"><table class="o_triton_table"><thead><tr><th>CPL</th><th>Capaian</th><th>Status</th><th>CPMK kontributor</th><th>Mata kuliah</th></tr></thead><tbody><tr t-foreach="grades" t-as="grade"><td><strong t-out="grade['name']"/><br/><span class="o_triton_caption" t-out="grade['description']"/></td><td><strong><t t-out="grade['score']"/>%</strong><br/><span class="o_triton_caption">Target <t t-out="grade['target']"/>%</span></td><td><span t-if="grade['met']" class="o_triton_badge o_triton_badge-success">Tercapai</span><span t-else="" class="o_triton_badge o_triton_badge-warning">Belum tercapai</span></td><td><div t-foreach="grade['contributions']" t-as="item"><strong t-out="item['cpmk']"/></div></td><td><div t-foreach="grade['contributions']" t-as="item"><t t-out="item['course_code']"/> — <t t-out="item['course']"/>: <strong><t t-out="item['score']"/>%</strong><span t-if="not item['available']" class="o_triton_caption"> (belum tersedia)</span></div></td></tr></tbody></table></div><div t-else="" class="o_triton_empty"><h2>Belum ada capaian CPL</h2><p>Tidak ada CPL yang cocok dengan pencarian Anda.</p></div><aside class="o_triton_privacy-note o_triton_section-heading">Capaian individu merupakan data privat dan tidak ditampilkan dalam halaman publik.</aside></div></section><t t-call="erpobe.triton_footer"/></main></t>
    </template>

</odoo>
