<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_erpobe" model="ir.module.category">
        <field name="name">ERP OBE</field>
        <field name="sequence">30</field>
    </record>

    <record id="erpobe_groups_privilege" model="res.groups.privilege">
        <field name="name">ERP OBE</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="erpobe.module_category_erpobe"/>
    </record>

    <record id="group_mahasiswa" model="res.groups">
        <field name="name">Mahasiswa</field>
        <field name="privilege_id" ref="erpobe.erpobe_groups_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_dosen" model="res.groups">
        <field name="name">Dosen</field>
        <field name="privilege_id" ref="erpobe.erpobe_groups_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="erpobe.erpobe_groups_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_superadmin" model="res.groups">
        <field name="name">Superadmin</field>
        <field name="privilege_id" ref="erpobe.erpobe_groups_privilege"/>
        <field name="implied_ids" eval="[(4, ref('erpobe.group_admin'))]"/>
    </record>
</odoo>