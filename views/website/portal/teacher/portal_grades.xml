<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="triton_teacher_grades_page" name="Input Nilai Dosen">
        <t t-call="website.layout"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><main class="o_triton_page o_triton_portal-page"><t t-call="erpobe.triton_portal_nav"/><section class="o_triton_section"><div class="o_triton_container"><header class="o_triton_heading"><div><span class="o_triton_eyebrow">Dosen • <t t-out="course_code"/></span><h1>Input nilai komponen</h1><p class="o_triton_subtitle"><t t-out="course"/> • <t t-out="year"/> • <t t-out="semester"/>. Nilai 0–100; penyimpanan memperbarui kalkulasi CPMK, CPL, dan KHS.</p></div></header><div t-if="error" class="o_triton_error" role="alert" t-out="error"/><t t-call="erpobe.triton_portal_list_controls"/><details class="o_triton_panel o_triton_section-heading"><summary>Komponen, bobot mata kuliah, dan CPMK terukur</summary><ul class="o_triton_list"><t t-foreach="components" t-as="component"><li><strong t-out="component['name']"/> — <t t-out="component['weight']"/>%<ul><t t-foreach="component['cpmks']" t-as="cpmk"><li><t t-out="cpmk['name']"/> (<t t-out="cpmk['weight']"/>% alokasi CPMK)</li></t></ul></li></t></ul></details><p class="o_triton_caption">Kelengkapan pada halaman ini: <strong t-out="completed_count"/> dari <t t-out="len(students)"/> mahasiswa memiliki nilai aktual untuk seluruh komponen.</p><form t-if="students" t-att-action="grade_action" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label for="audit-reason">Alasan perubahan (opsional)</label><input id="audit-reason" name="audit_reason" type="text" maxlength="255" placeholder="Contoh: koreksi setelah verifikasi"/><div class="o_triton_table-wrap"><table class="o_triton_table"><thead><tr><th>NIM</th><th>Mahasiswa</th><th>Status</th><t t-foreach="students[0]['values']" t-as="component"><th t-out="component['name']"/></t><th>Perhitungan</th></tr></thead><tbody><t t-foreach="students" t-as="student"><tr><th t-out="student['nim']"/><td t-out="student['name']"/><td><span t-if="student['complete']" class="o_triton_badge o_triton_badge-success">Lengkap</span><span t-else="" class="o_triton_badge o_triton_badge-warning">Belum lengkap</span></td><t t-foreach="student['values']" t-as="value"><td><label class="visually-hidden" t-att-for="'grade-%s-%s' % (student['id'], value['id'])" t-out="value['name']"/><input class="o_triton_grade-input" type="number" min="0" max="100" step="0.01" t-att-id="'grade-%s-%s' % (student['id'], value['id'])" t-att-name="'grade_%s_%s' % (student['id'], value['id'])" t-att-value="value['value']"/></td></t><td><details><summary>Nilai akhir <t t-if="student['final_score'] is not None"><t t-out="student['final_score']"/></t><t t-else="">Belum dihitung</t></summary><ul><t t-foreach="student['cpmks']" t-as="cpmk"><li><t t-out="cpmk['name']"/>: <t t-out="cpmk['score']"/>% — <t t-if="cpmk['met']">Tercapai</t><t t-else="">Belum tercapai</t></li></t></ul></details></td></tr></t></tbody></table></div><button class="o_triton_btn o_triton_section-heading" type="submit">Simpan halaman dan hitung ulang kelas</button></form><div t-else="" class="o_triton_empty"><p>Belum ada peserta pada kelas ini.</p></div></div></section><t t-call="erpobe.triton_footer"/></main></t>
    </template>
    <template id="triton_grade_history_page" name="Riwayat Perubahan Nilai">
        <t t-call="website.layout"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><main class="o_triton_page o_triton_portal-page"><t t-call="erpobe.triton_portal_nav"/><section class="o_triton_section"><div class="o_triton_container"><header class="o_triton_heading"><div><span class="o_triton_eyebrow">Dosen</span><h1>Riwayat perubahan nilai</h1><p class="o_triton_subtitle">Audit log perubahan nilai untuk kelas yang menjadi tanggung jawab Anda.</p></div></header><t t-call="erpobe.triton_portal_list_controls"/><div t-if="history" class="o_triton_table-wrap"><table class="o_triton_table"><thead><tr><th>Waktu</th><th>Dosen</th><th>Mahasiswa</th><th>Komponen</th><th>Sebelum</th><th>Sesudah</th><th>Keterangan</th></tr></thead><tbody><t t-foreach="history" t-as="row"><tr><td t-out="row['time']"/><td t-out="row['user']"/><td t-out="row['student']"/><td t-out="row['component']"/><td t-out="row['old']"/><td t-out="row['new']"/><td t-out="row['reason']"/></tr></t></tbody></table></div><div t-else="" class="o_triton_empty"><h2>Belum ada perubahan nilai</h2><p>Tidak ada riwayat yang cocok dengan pencarian Anda.</p></div></div></section><t t-call="erpobe.triton_footer"/></main></t>
    </template>

</odoo>
