<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_erpobe_master_prodi_search" model="ir.ui.view">
        <field name="name">erpobe.master.prodi.search</field>
        <field name="model">erpobe.master.prodi</field>
        <field name="arch" type="xml">
            <search string="Program Studi">
                <field name="kode"/>
                <field name="name"/>
                <field name="fakultas_id"/>
                <filter name="archived" string="Diarsipkan" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="view_erpobe_master_prodi_list" model="ir.ui.view">
        <field name="name">erpobe.master.prodi.list</field>
        <field name="model">erpobe.master.prodi</field>
        <field name="arch" type="xml">
            <list string="Program Studi">
                <field name="kode"/>
                <field name="name"/>
                <field name="fakultas_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_erpobe_master_prodi_form" model="ir.ui.view">
        <field name="name">erpobe.master.prodi.form</field>
        <field name="model">erpobe.master.prodi</field>
        <field name="arch" type="xml">
            <form string="Program Studi">
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="kode"/>
                        <field name="name"/>
                        <field name="fakultas_id"/>
                        <button name="action_open_weight_monitor" type="object" string="Kelengkapan Bobot" class="oe_highlight"/>
                        <button name="action_open_tahun_ajaran" type="object" string="Tahun Ajaran"/>
                        <button name="action_open_penawaran" type="object" string="Penawaran Mata Kuliah"/>
                    </group>
                    <notebook>
                        <page string="CPL">
                            <field name="cpl_ids">
                                <list editable="bottom">
                                    <field name="kode_cpl"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="CPMK">
                            <field name="cpmk_ids" readonly="1">
                                <list>
                                    <field name="kode_cpmk"/>
                                    <field name="name"/>
                                    <field name="mk_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Dosen">
                            <field name="dosen_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Mahasiswa">
                            <field name="mahasiswa_ids" readonly="1">
                                <list>
                                    <field name="nim"/>
                                    <field name="name"/>
                                    <field name="rombel_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Mata Kuliah">
                            <field name="matakuliah_ids">
                                <list editable="bottom">
                                    <field name="kode_mk"/>
                                    <field name="name"/>
                                    <field name="sks"/>
                                    <field name="semester"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rombel">
                            <field name="rombel_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="angkatan"/>
                                </list>
                            </field>
                        </page>
                        <page string="Penawaran dan RPS">
                            <field name="penawaran_line_ids" readonly="1">
                                <list>
                                    <field name="penawaran_id"/>
                                    <field name="matakuliah_id"/>
                                    <field name="tahun_ajaran_id"/>
                                    <field name="rps_status" widget="badge"/>
                                    <field name="rps_weight_status" widget="badge"/>
                                </list>
                            </field>
                            <field name="rps_ids" readonly="1">
                                <list>
                                    <field name="matakuliah_id"/>
                                    <field name="tahun_ajaran_id"/>
                                    <field name="version"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Metode Pembelajaran">
                            <field name="metode_ids">
                                <list editable="bottom">
                                    <field name="kode"/>
                                    <field name="name"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Referensi Akademik">
                            <field name="referensi_ids">
                                <list editable="bottom">
                                    <field name="kode"/>
                                    <field name="judul"/>
                                    <field name="penulis"/>
                                    <field name="tahun"/>
                                    <field name="jenis"/>
                                    <field name="link" widget="url"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_erpobe_master_prodi" model="ir.actions.act_window">
        <field name="name">Program Studi</field>
        <field name="res_model">erpobe.master.prodi</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_erpobe_master_prodi_search"/>
    </record>
</odoo>
