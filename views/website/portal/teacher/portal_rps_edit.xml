<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="triton_rps_edit_page" name="Editor RPS Portal">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
            <main class="o_triton_page o_triton_portal-page">
                <t t-call="erpobe.triton_portal_nav"/>
                <section class="o_triton_section"><div class="o_triton_container">
                    <header class="o_triton_heading"><div><span class="o_triton_eyebrow">Dosen • RPS v<t t-out="rps.version"/></span><h1 t-out="line.matakuliah_id.name"/><p class="o_triton_subtitle"><t t-out="line.tahun_ajaran_id.tahun_ajaran"/> • <t t-out="line.tahun_ajaran_id.semester"/> • Status <t t-out="rps.status"/></p></div></header>
                    <div t-if="error" class="o_triton_error" role="alert" t-out="error"/>
                    <div t-if="message" class="o_triton_success" role="status" t-out="message"/>
                    <form method="post" class="o_triton_panel o_triton_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <section class="o_triton_section-heading"><h2>Identitas dan deskripsi</h2><dl class="o_triton_definition-grid"><div><dt>Kode mata kuliah</dt><dd t-out="rps.kode_mk"/></div><div><dt>SKS</dt><dd t-out="rps.sks"/></div><div><dt>Program studi</dt><dd t-out="rps.prodi_id.name"/></div></dl><label>Deskripsi mata kuliah<textarea name="deskripsi_mk" rows="4" t-out="rps.deskripsi_mk"/></label><label>Tujuan pembelajaran<textarea name="tujuan_pembelajaran" rows="3" t-out="rps.tujuan_pembelajaran or ''"/></label></section>
                        <section class="o_triton_section-heading"><h2>Bahan dan media pembelajaran</h2><label>Materi pembelajaran<textarea name="materi_pembelajaran" rows="4" t-out="rps.materi_pembelajaran or ''"/></label><label>Sumber belajar<textarea name="sumber_belajar" rows="3" t-out="rps.sumber_belajar or ''"/></label><div class="o_triton_form-row"><label>Media software<input name="media_software" t-att-value="rps.media_software or ''"/></label><label>Media hardware<input name="media_hardware" t-att-value="rps.media_hardware or ''"/></label></div></section>
                        <section class="o_triton_section-heading"><h2>CPMK dan CPL</h2><div class="o_triton_table-wrap"><table class="o_triton_table"><thead><tr><th>CPMK</th><th>Deskripsi</th><th>CPL terkait</th></tr></thead><tbody><tr t-foreach="rps.cpmk_ids" t-as="cpmk"><td t-out="cpmk.kode_cpmk"/><td t-out="cpmk.name"/><td><span t-foreach="cpmk.cpl_ids" t-as="cpl"><t t-out="cpl.kode_cpl"/> </span></td></tr></tbody></table></div></section>
                        <section class="o_triton_section-heading"><h2>Komponen penilaian</h2><fieldset><legend>Pilih komponen</legend><div class="o_triton_grid-three"><t t-foreach="components" t-as="component"><label class="o_triton_checkbox"><input type="checkbox" name="komponen_ids" t-att-value="component.id" t-att-checked="component in rps.komponen_ids"/><t t-out="component.name"/></label></t></div></fieldset><h3>Bobot CPMK → Mata Kuliah</h3><div class="o_triton_table-wrap"><table class="o_triton_table"><thead><tr><th>CPMK</th><th>Bobot (%)</th></tr></thead><tbody><tr t-foreach="rps.bobot_cpmk_mk_ids" t-as="weight"><td t-out="weight.cpmk_id.name"/><td><input class="o_triton_grade-input" type="number" min="0" max="100" step="0.01" t-att-name="'bobot_mk_%s' % weight.id" t-att-value="weight.bobot_cpmk_mk"/></td></tr></tbody></table></div><h3>Bobot Komponen → CPMK</h3><div class="o_triton_table-wrap"><table class="o_triton_table"><thead><tr><th>Komponen</th><th>CPMK</th><th>Bobot (%)</th></tr></thead><tbody><tr t-foreach="rps.bobot_komponen_cpmk_ids" t-as="weight"><td t-out="weight.komponen_penilaian.name"/><td t-out="weight.cpmk_id.name"/><td><input class="o_triton_grade-input" type="number" min="0" max="100" step="0.01" t-att-name="'bobot_komponen_%s' % weight.id" t-att-value="weight.bobot_komponen_cpmk"/></td></tr></tbody></table></div></section>
                        <section class="o_triton_section-heading"><h2>Rencana kegiatan perkuliahan</h2><div class="o_triton_table-wrap"><table class="o_triton_table"><thead><tr><th>Minggu</th><th>Bahan kajian</th><th>Pengalaman belajar</th><th>Waktu (menit)</th><th>Teknik penilaian</th></tr></thead><tbody><tr t-foreach="rps.kegiatan_perkuliahan_ids" t-as="activity"><td t-out="activity.minggu"/><td><textarea t-att-name="'bahan_%s' % activity.id" rows="3" t-out="activity.bahan_kajian"/></td><td><textarea t-att-name="'pengalaman_%s' % activity.id" rows="3" t-out="activity.pengalaman_belajar or ''"/></td><td><input type="number" min="0" t-att-name="'waktu_%s' % activity.id" t-att-value="activity.estimasi_waktu"/></td><td><input t-att-name="'penilaian_%s' % activity.id" t-att-value="activity.teknik_penilaian or ''"/></td></tr></tbody></table></div></section>
                        <section class="o_triton_section-heading"><h2>Referensi</h2><fieldset><legend>Pilih referensi utama dan pendukung</legend><div class="o_triton_grid-three"><label t-foreach="references" t-as="reference" class="o_triton_checkbox"><input type="checkbox" name="referensi_ids" t-att-value="reference.id" t-att-checked="reference in rps.referensi_ids"/><t t-out="reference.judul"/></label></div></fieldset></section>
                        <div class="o_triton_hero-actions"><a class="o_triton_btn-ghost" t-att-href="'/my/rps/detail/%s' % rps.id">Kembali ke detail</a><t t-if="rps.status != 'final'"><button class="o_triton_btn-ghost" type="submit" name="operation" value="draft">Simpan Draft</button><button class="o_triton_btn" type="submit" name="operation" value="review">Simpan dan ajukan tinjauan</button></t></div>
                    </form>
                </div></section>
                <t t-call="erpobe.triton_footer"/>
            </main>
        </t>
    </template>

</odoo>
