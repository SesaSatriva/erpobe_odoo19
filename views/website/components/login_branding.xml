<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="triton_login_branding" inherit_id="web.login_layout" name="Logo TRITON pada halaman login">
        <xpath expr="//div[hasclass('text-center', 'pb-3', 'border-bottom', 'mb-4')]//img" position="attributes">
            <attribute name="src">/erpobe/static/src/img/logo_triton.jpeg</attribute>
            <attribute name="alt">TRITON</attribute>
            <attribute name="style">width: 180px; max-width: 100%; height: 64px; object-fit: contain;</attribute>
        </xpath>
    </template>

    <template id="triton_website_login_branding" inherit_id="website.login_layout" name="Logo TRITON pada login website" priority="30">
        <xpath expr="//t[@t-call='website.layout']" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
                <t t-set="body_classname" t-value="'bg-100'"/>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <div class="container py-5">
                    <div t-attf-class="card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list" style="max-width: 300px;">
                        <div class="card-body">
                            <div class="text-center pb-3 border-bottom mb-4">
                                <a href="/" aria-label="TRITON, beranda">
                                    <img class="o_triton_login-logo" src="/erpobe/static/src/img/logo_triton.jpeg" alt="TRITON"/>
                                </a>
                            </div>
                            <t t-out="0"/>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
