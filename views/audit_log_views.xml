<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_erpobe_audit_log_list" model="ir.ui.view">
        <field name="name">erpobe.audit.log.list</field>
        <field name="model">erpobe.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Trail" default_order="timestamp desc">
                <field name="timestamp"/>
                <field name="user_id"/>
                <field name="user_role_snapshot"/>
                <field name="action_type"/>
                <field name="model_description"/>
                <field name="record_name_snapshot"/>
                <field name="description"/>
                <field name="source"/>
                <field name="severity"/>
            </list>
        </field>
    </record>

    <record id="view_erpobe_audit_log_form" model="ir.ui.view">
        <field name="name">erpobe.audit.log.form</field>
        <field name="model">erpobe.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Detail" create="false" edit="false" delete="false">
                <sheet>
                    <group string="Activity Information">
                        <field name="user_id"/>
                        <field name="user_role_snapshot"/>
                        <field name="timestamp"/>
                        <field name="action_type"/>
                        <field name="source"/>
                        <field name="description"/>
                        <field name="severity"/>
                        <field name="status"/>
                    </group>
                    <group string="Record Information">
                        <field name="model_name"/>
                        <field name="model_description"/>
                        <field name="record_id"/>
                        <field name="record_name_snapshot"/>
                        <field name="module_name"/>
                    </group>
                    <group string="Request Information">
                        <field name="ip_address"/>
                        <field name="user_agent"/>
                        <field name="correlation_id"/>
                    </group>
                    <group string="Changes">
                        <field name="changed_fields"/>
                        <field name="changes_html" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_erpobe_audit_log_search" model="ir.ui.view">
        <field name="name">erpobe.audit.log.search</field>
        <field name="model">erpobe.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_name_snapshot"/>
                <field name="user_role_snapshot"/>
                <field name="model_name"/>
                <field name="record_name_snapshot"/>
                <filter name="today" string="Hari Ini" domain="[('timestamp','&gt;=', context_today())]"/>
                <filter name="seven_days" string="7 Hari Terakhir" domain="[('timestamp','&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="thirty_days" string="30 Hari Terakhir" domain="[('timestamp','&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="create" string="CREATE" domain="[('action_type','=','CREATE')]"/>
                <filter name="update" string="UPDATE" domain="[('action_type','=','UPDATE')]"/>
                <filter name="delete" string="DELETE" domain="[('action_type','=','DELETE')]"/>
                <filter name="workflow" string="Workflow" domain="[('event_type','=','WORKFLOW')]"/>
                <filter name="import" string="Import" domain="[('action_type','=','IMPORT')]"/>
                <filter name="export" string="Export" domain="[('action_type','=','EXPORT')]"/>
                <filter name="print" string="Print" domain="[('action_type','in',['PRINT','REPORT_GENERATION'])]"/>
                <filter name="security" string="Security Event" domain="[('event_type','=','SECURITY')]"/>
                <filter name="group_user" string="User" context="{'group_by':'user_id'}"/>
                <filter name="group_model" string="Model" context="{'group_by':'model_name'}"/>
                <filter name="group_action" string="Action" context="{'group_by':'action_type'}"/>
                <filter name="group_event" string="Event Type" context="{'group_by':'event_type'}"/>
                <filter name="group_source" string="Source" context="{'group_by':'source'}"/>
                <filter name="group_date" string="Date" context="{'group_by':'timestamp:day'}"/>
            </search>
        </field>
    </record>

    <record id="view_erpobe_audit_log_graph" model="ir.ui.view">
        <field name="name">erpobe.audit.log.graph</field>
        <field name="model">erpobe.audit.log</field>
        <field name="arch" type="xml">
            <graph string="Activity" type="bar">
                <field name="timestamp" interval="day"/>
                <field name="action_type" type="row"/>
            </graph>
        </field>
    </record>

    <record id="action_erpobe_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">erpobe.audit.log</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_erpobe_audit_log_search"/>
        <field name="context">{'search_default_thirty_days': 1}</field>
    </record>

    <record id="view_erpobe_audit_dashboard_form" model="ir.ui.view">
        <field name="name">erpobe.audit.dashboard.form</field>
        <field name="model">erpobe.audit.dashboard</field>
        <field name="arch" type="xml">
            <form string="Activity Tracking" create="false" edit="false" delete="false">
                <sheet>
                    <group col="4">
                        <field name="total_today"/>
                        <field name="total_7_days"/>
                        <field name="total_month"/>
                        <field name="total_active_users"/>
                        <field name="total_create"/>
                        <field name="total_update"/>
                        <field name="total_delete"/>
                        <field name="total_workflow"/>
                        <field name="total_sensitive"/>
                        <field name="total_records"/>
                        <field name="expired_ordinary_records"/>
                        <field name="expired_critical_records"/>
                        <field name="growth_last_month"/>
                        <field name="retention_cron_status"/>
                        <field name="retention_cron_last_run"/>
                    </group>
                    <notebook>
                        <page string="Aktivitas Terbaru">
                            <field name="recent_log_ids" readonly="1">
                                <list default_order="timestamp desc">
                                    <field name="timestamp"/>
                                    <field name="user_id"/>
                                    <field name="user_role_snapshot"/>
                                    <field name="action_type"/>
                                    <field name="model_description"/>
                                    <field name="record_name_snapshot"/>
                                    <field name="description"/>
                                    <field name="source"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_erpobe_audit_dashboard" model="ir.actions.act_window">
        <field name="name">Activity Tracking</field>
        <field name="res_model">erpobe.audit.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
