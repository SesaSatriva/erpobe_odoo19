<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_erpobe_master_fakultas_search" model="ir.ui.view">
        <field name="name">erpobe.master.fakultas.search</field>
        <field name="model">erpobe.master.fakultas</field>
        <field name="arch" type="xml">
            <search string="Fakultas">
                <field name="kode"/>
                <field name="name"/>
                <field name="dekan_id" domain="[('prodi_ids.fakultas_id', '=', id)]"/>
                <filter name="archived" string="Diarsipkan" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="view_erpobe_master_fakultas_list" model="ir.ui.view">
        <field name="name">erpobe.master.fakultas.list</field>
        <field name="model">erpobe.master.fakultas</field>
        <field name="arch" type="xml">
            <list string="Fakultas">
                <field name="kode"/>
                <field name="name"/>
                <field name="dekan_id"/>
            </list>
        </field>
    </record>
    <record id="view_erpobe_master_fakultas_form" model="ir.ui.view">
        <field name="name">erpobe.master.fakultas.form</field>
        <field name="model">erpobe.master.fakultas</field>
        <field name="arch" type="xml">
            <form string="Fakultas">
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="kode"/>
                        <field name="name"/>
                        <field name="dekan_id"/>
                    </group>
                    <notebook>
                        <page string="Program Studi">
                            <field name="prodi_ids">
                                <list>
                                    <field name="kode"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_erpobe_master_fakultas" model="ir.actions.act_window">
        <field name="name">Fakultas</field>
        <field name="res_model">erpobe.master.fakultas</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_erpobe_master_fakultas_search"/>
    </record>
</odoo>
