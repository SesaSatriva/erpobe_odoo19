<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_erpobe_cpl_search" model="ir.ui.view">
        <field name="name">erpobe.akademik.cpl.search</field>
        <field name="model">erpobe.akademik.cpl</field>
        <field name="arch" type="xml">
            <search string="Capaian Pembelajaran Lulusan">
                <field name="kode_cpl"/>
                <field name="name"/>
                <field name="jenis_cpl"/>
                <field name="prodi_id"/>
                <filter name="group_prodi" string="Program Studi" context="{'group_by': 'prodi_id'}"/>
            </search>
        </field>
    </record>
    <record id="view_erpobe_cpl_list" model="ir.ui.view">
        <field name="name">erpobe.akademik.cpl.list</field>
        <field name="model">erpobe.akademik.cpl</field>
        <field name="arch" type="xml">
            <list string="Capaian Pembelajaran Lulusan">
                <field name="kode_cpl"/>
                <field name="name"/>
                <field name="jenis_cpl"/>
                <field name="prodi_id"/>
            </list>
        </field>
    </record>
    <record id="view_erpobe_cpl_form" model="ir.ui.view">
        <field name="name">erpobe.akademik.cpl.form</field>
        <field name="model">erpobe.akademik.cpl</field>
        <field name="arch" type="xml">
            <form string="Capaian Pembelajaran Lulusan">
                <sheet>
                    <div class="oe_title">
                        <label for="kode_cpl"/>
                        <h1>
                            <field name="kode_cpl"/>
                        </h1>
                    </div>
                    <group>
                        <field name="prodi_id"/>
                        <field name="jenis_cpl"/>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Pemetaan CPMK">
                            <field name="cpmk_mapping_ids">
                                <list editable="bottom">
                                    <field name="cpmk_id" domain="[('prodi_id', '=', parent.prodi_id)]"/>
                                    <field name="mk_id" readonly="1"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="cpl_id" readonly="1"/>
                                        <field name="cpmk_id" domain="[('prodi_id', '=', parent.prodi_id)]"/>
                                        <field name="mk_id" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_erpobe_cpl" model="ir.actions.act_window">
        <field name="name">Capaian Pembelajaran Lulusan</field>
        <field name="res_model">erpobe.akademik.cpl</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_erpobe_cpl_search"/>
    </record>
</odoo>
