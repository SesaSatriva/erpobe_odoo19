<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="triton_khs_page" name="KHS Mahasiswa">
        <t t-call="website.layout"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><main class="o_triton_page o_triton_portal-page"><t t-call="erpobe.triton_portal_nav"/><section class="o_triton_section"><div class="o_triton_container"><header class="o_triton_heading"><div><span class="o_triton_eyebrow">Mahasiswa</span><h1>Kartu Hasil Studi dan Transkrip</h1><p class="o_triton_subtitle">Hanya laporan milik akun yang sedang masuk.</p></div></header><t t-if="reports"><t t-foreach="reports" t-as="report"><article class="o_triton_panel o_triton_section-heading"><div class="o_triton_heading"><div><h2 t-out="report['year']"/><p>IPK <strong t-out="report['ipk']"/> • SKS lulus <strong t-out="report['sks']"/></p></div><div class="o_triton_hero-actions"><a class="o_triton_btn-ghost" t-att-href="'/report/pdf/erpobe.action_report_khs/%s' % report['id']">Cetak PDF</a><a class="o_triton_btn-ghost" t-att-href="'/my/khs/%s/xlsx' % report['id']">Unduh XLSX</a></div></div><t t-call="erpobe.triton_portal_list_controls"/><div t-if="report['courses']" class="o_triton_table-wrap"><table class="o_triton_table"><thead><tr><th>Kode</th><th>Mata Kuliah</th><th>SKS</th><th>Nilai angka</th><th>Nilai huruf</th></tr></thead><tbody><t t-foreach="report['courses']" t-as="course"><tr><td t-out="course['kode']"/><td t-out="course['name']"/><td t-out="course['sks']"/><td t-out="course['score']"/><td t-out="course['grade']"/></tr></t></tbody></table></div><div t-else="" class="o_triton_empty"><p>Tidak ada mata kuliah yang cocok dengan pencarian Anda.</p></div></article></t></t><div t-else="" class="o_triton_empty"><h2>Belum ada KHS</h2><p>Laporan hasil studi akan tersedia setelah nilai diproses oleh pengajar.</p></div><p class="o_triton_caption">Ringkasan IPS per semester tidak tersedia karena data nilai mata kuliah saat ini tidak mencatat tahun ajaran pada tiap nilai.</p></div></section><t t-call="erpobe.triton_footer"/></main></t>
    </template>

</odoo>
