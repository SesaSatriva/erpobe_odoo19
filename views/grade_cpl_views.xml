<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_erpobe_grade_cpl_rombel_list" model="ir.ui.view">
        <field name="name">erpobe.grade.cpl.rombel.list</field>
        <field name="model">erpobe.grade.cpl.rombel</field>
        <field name="arch" type="xml">
            <list string="Rata-rata CPL per Rombel">
                <field name="fakultas_id"/>
                <field name="prodi_id"/>
                <field name="rombel_id"/>
                <field name="cpl_id"/>
                <field name="nilai_rata_cpl"/>
            </list>
        </field>
    </record>
    <record id="view_erpobe_grade_cpl_angkatan_list" model="ir.ui.view">
        <field name="name">erpobe.grade.cpl.angkatan.list</field>
        <field name="model">erpobe.grade.cpl.angkatan</field>
        <field name="arch" type="xml">
            <list string="Rata-rata CPL per Angkatan">
                <field name="angkatan"/>
                <field name="prodi_id"/>
                <field name="cpl_id"/>
                <field name="nilai_rata_cpl"/>
            </list>
        </field>
    </record>
    <record id="action_erpobe_grade_cpl_rombel" model="ir.actions.act_window">
        <field name="name">CPL per Rombel</field>
        <field name="res_model">erpobe.grade.cpl.rombel</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_erpobe_grade_cpl_angkatan" model="ir.actions.act_window">
        <field name="name">CPL per Angkatan</field>
        <field name="res_model">erpobe.grade.cpl.angkatan</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
