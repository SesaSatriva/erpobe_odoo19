<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="menu_triton_public" model="website.menu">
        <field name="name">TRITON</field>
        <field name="url">/</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">1</field>
    </record>

    <template id="triton_main_nav" name="Navigasi TRITON">
        <t t-set="public_path" t-value="request.httprequest.path.rstrip('/') or '/'"/>
        <t t-set="public_links" t-value="[
            ('Beranda', '/'),
            ('Fakultas &amp; Prodi', '/fakultas'),
            ('Perbandingan CPL', '/perbandingan-cpl'),
            ('Tracking', '/tracking'),
            ('Tentang', '/tentang')
        ]"/>
        <nav class="o_triton_navbar" aria-label="Navigasi utama TRITON">
            <div class="o_triton_nav-inner">
                <a class="o_triton_brand" href="/" aria-label="TRITON, beranda">
                    <img class="o_triton_brand-logo" src="/erpobe/static/src/img/logo_triton.png" alt="TRITON"/>
                </a>
                <details class="o_triton_mobile-menu">
                    <summary aria-label="Buka menu">Menu</summary>
                    <div class="o_triton_nav-links">
                        <a t-foreach="public_links" t-as="link" t-att-href="link[1]"
                            t-att-class="'o_triton_nav-link' + (' is-active' if public_path == link[1] or (link[1] != '/' and public_path.startswith(link[1] + '/')) or (link[1] == '/fakultas' and public_path.startswith('/prodi/')) else '')"
                            t-att-aria-current="'page' if public_path == link[1] or (link[1] != '/' and public_path.startswith(link[1] + '/')) or (link[1] == '/fakultas' and public_path.startswith('/prodi/')) else None"
                            t-out="link[0]"/>
                        <a href="/panduan" t-att-class="'o_triton_nav-link' + (' is-active' if public_path == '/panduan' else '')"
                            t-att-aria-current="'page' if public_path == '/panduan' else None">Panduan</a>
                        <a href="/faq" t-att-class="'o_triton_nav-link' + (' is-active' if public_path == '/faq' else '')"
                            t-att-aria-current="'page' if public_path == '/faq' else None">FAQ</a>
                    </div>
                </details>
                <div class="o_triton_desktop-links o_triton_nav-links">
                    <a t-foreach="public_links" t-as="link" t-att-href="link[1]"
                        t-att-class="'o_triton_nav-link' + (' is-active' if public_path == link[1] or (link[1] != '/' and public_path.startswith(link[1] + '/')) or (link[1] == '/fakultas' and public_path.startswith('/prodi/')) else '')"
                        t-att-aria-current="'page' if public_path == link[1] or (link[1] != '/' and public_path.startswith(link[1] + '/')) or (link[1] == '/fakultas' and public_path.startswith('/prodi/')) else None"
                        t-out="link[0]"/>
                </div>
                <a t-if="request.env.user._is_public()" href="/web/login?redirect=/my/triton" class="o_triton_btn-secondary">Masuk Portal</a>
                <a t-else="" href="/my/triton" class="o_triton_btn-secondary">Buka Portal</a>
            </div>
        </nav>
    </template>

    <template id="triton_footer" name="Footer TRITON">
        <footer class="o_triton_footer">
            <div class="o_triton_container o_triton_footer-grid">
                <div>
                    <a class="o_triton_brand" href="/">
                        <img class="o_triton_brand-logo" src="/erpobe/static/src/img/logo_triton.png" alt="TRITON"/>
                    </a>
                    <p>Tracking, Reporting, and Integrated Technology for Outcome-based Education Network.</p>
                </div>
                <div>
                    <h2>Jelajah</h2>
                    <ul class="o_triton_list">
                        <li><a href="/fakultas">Fakultas dan program studi</a></li>
                        <li><a href="/perbandingan-cpl">Perbandingan CPL</a></li>
                        <li><a href="/tracking">Tracking agregat</a></li>
                    </ul>
                </div>
                <div>
                    <h2>Bantuan</h2>
                    <ul class="o_triton_list">
                        <li><a href="/panduan">Panduan</a></li>
                        <li><a href="/faq">FAQ</a></li>
                        <li><a href="/kontak">Kontak</a></li>
                    </ul>
                </div>
                <div>
                    <h2>Informasi</h2>
                    <ul class="o_triton_list">
                        <li><a href="/metodologi">Metodologi</a></li>
                        <li><a href="/kebijakan-privasi">Kebijakan privasi</a></li>
                        <li><a href="/my">Portal pengguna</a></li>
                    </ul>
                </div>
            </div>
            <div class="o_triton_container">
                <small>TRITON — pemantauan capaian pembelajaran berbasis OBE.</small>
            </div>
        </footer>
    </template>

</odoo>
