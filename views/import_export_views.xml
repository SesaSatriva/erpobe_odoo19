<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_erpobe_wizard_import_fakultas_form" model="ir.ui.view">
        <field name="name">erpobe.wizard.import.fakultas.form</field>
        <field name="model">erpobe.wizard.import.fakultas</field>
        <field name="arch" type="xml">
            <form string="Import / Export Fakultas">
                <group>
                    <field name="mode" widget="radio"/>
                </group>
                <notebook>
                    <page string="Impor" invisible="mode != 'import'">
                        <group>
                            <field name="format"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="dry_run"/>
                            <field name="update_existing"/>
                            <field name="stop_on_error"/>
                        </group>
                        <button
                            name="action_download_template"
                            type="object"
                            string="Unduh Template"
                            class="btn-secondary"
                        />
                        <field
                            name="template_file"
                            filename="template_filename"
                            readonly="1"
                        />
                        <field name="template_filename" invisible="1"/>
                        <button
                            name="action_validate"
                            type="object"
                            string="Validasi"
                            class="btn-secondary"
                        />
                        <button
                            name="action_import"
                            type="object"
                            string="Impor"
                            class="btn-primary"
                            invisible="dry_run"
                        />
                    </page>
                    <page string="Ekspor" invisible="mode != 'export'">
                        <group>
                            <field name="format"/>
                            <field name="export_selected"/>
                            <field
                                name="filter_fakultas_id"
                                invisible="not filter_fakultas_available"
                            />
                            <field
                                name="filter_prodi_id"
                                invisible="not filter_prodi_available"
                            />
                        </group>
                        <button
                            name="action_export"
                            type="object"
                            string="Ekspor"
                            class="btn-primary"
                        />
                        <field
                            name="export_file"
                            filename="export_filename"
                            readonly="1"
                        />
                        <field name="export_filename" invisible="1"/>
                    </page>
                    <page string="Panduan">
                        <field name="guide" nolabel="1" readonly="1"/>
                    </page>
                    <page string="Hasil" invisible="not result_summary">
                        <field name="state"/>
                        <field name="result_summary" nolabel="1" readonly="1"/>
                        <button
                            name="action_download_error_report"
                            type="object"
                            string="Unduh Laporan Kesalahan"
                            class="btn-secondary"
                            invisible="not error_file"
                        />
                        <field
                            name="error_file"
                            filename="error_filename"
                            readonly="1"
                            invisible="not error_file"
                        />
                        <field name="error_filename" invisible="1"/>
                    </page>
                </notebook>
                <footer>
                    <button string="Tutup" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

