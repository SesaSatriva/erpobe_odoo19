<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="triton_student_courses_page" name="Mata Kuliah Mahasiswa">
        <t t-call="website.layout"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><main class="o_triton_page o_triton_portal-page"><t t-call="erpobe.triton_portal_nav"/><section class="o_triton_section"><div class="o_triton_container"><header class="o_triton_heading"><div><span class="o_triton_eyebrow">Mahasiswa</span><h1>Mata kuliah saya</h1><p class="o_triton_subtitle">Daftar berasal dari KRS yang telah disetujui.</p></div></header><t t-call="erpobe.triton_portal_list_controls"/><div t-if="courses" class="o_triton_grid-three"><t t-foreach="courses" t-as="course"><article class="o_triton_panel"><span class="o_triton_badge" t-out="course['year']"/> <h2 t-out="course['name']"/><p><t t-out="course['code']"/> • <t t-out="course['sks']"/> SKS • <t t-out="course['semester']"/></p><p><span t-if="course['rps']" class="o_triton_badge o_triton_badge-success">RPS Final</span><span t-else="" class="o_triton_badge o_triton_badge-warning">RPS Final belum tersedia</span></p><h3>CPMK</h3><ul class="o_triton_list"><t t-foreach="course['cpmk']" t-as="item"><li t-out="item['name']"/></t></ul><h3>Hasil Sub-CPMK</h3><ul class="o_triton_list"><t t-foreach="course['subcpmk']" t-as="item"><li><strong>Minggu <t t-out="item['week']"/>:</strong> <t t-out="item['name']"/> — <t t-out="item['score']"/> / <t t-out="item['target']"/> <span t-if="item['met']" class="o_triton_badge-success">Tercapai</span><span t-else="" class="o_triton_badge-warning">Belum tercapai</span></li></t></ul><h3>Nilai komponen</h3><ul class="o_triton_list"><t t-foreach="course['components']" t-as="component"><li><t t-out="component['name']"/>: <t t-out="component['score']"/></li></t></ul></article></t></div><div t-else="" class="o_triton_empty"><h2>Belum ada mata kuliah</h2><p>Tidak ada mata kuliah yang cocok dengan pencarian Anda.</p></div></div></section><t t-call="erpobe.triton_footer"/></main></t>
    </template>

</odoo>
