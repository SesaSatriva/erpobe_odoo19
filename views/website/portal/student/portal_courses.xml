<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="triton_student_courses_page" name="Mata Kuliah Mahasiswa">
        <t t-call="website.layout"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><main class="o_triton_page o_triton_portal-page"><t t-call="erpobe.triton_portal_nav"/><section class="o_triton_section"><div class="o_triton_container"><header class="o_triton_heading"><div><span class="o_triton_eyebrow">Mahasiswa</span><h1>Mata kuliah saya</h1><p class="o_triton_subtitle">Daftar berasal dari KRS yang telah disetujui.</p></div></header><t t-call="erpobe.triton_portal_list_controls"/><div t-if="courses" class="o_triton_table-wrap"><table class="o_triton_table"><thead><tr><th>Mata kuliah</th><th>Tahun / Semester</th><th>CPMK dan CPL</th><th>Capaian CPMK</th><th>Nilai komponen</th><th>RPS</th></tr></thead><tbody><tr t-foreach="courses" t-as="course"><td><strong t-out="course['code']"/> — <t t-out="course['name']"/><br/><span class="o_triton_caption"><t t-out="course['sks']"/> SKS</span></td><td><t t-out="course['year']"/> • <t t-out="course['semester']"/></td><td><t t-if="course['cpmk']"><div t-foreach="course['cpmk']" t-as="cpmk"><strong t-out="cpmk['code']"/></div></t><t t-else="">-</t></td><td><div t-foreach="course['cpmk']" t-as="cpmk"><strong t-out="cpmk['code']"/>: <t t-out="cpmk['score']"/>% <span class="o_triton_caption">(target <t t-out="cpmk['target']"/>%)</span></div><span t-if="not course['cpmk']" class="o_triton_caption">Belum ada CPMK</span></td><td><div t-foreach="course['components']" t-as="component"><t t-out="component['name']"/>: <strong t-out="component['score']"/></div><span t-if="not course['components']" class="o_triton_caption">Belum dinilai</span></td><td><span t-if="course['rps']" class="o_triton_badge o_triton_badge-success">RPS Final</span><span t-else="" class="o_triton_badge o_triton_badge-warning">Belum tersedia</span><br/><a t-if="course['rps_id']" class="o_triton_link" t-att-href="'/my/rps/%s' % course['rps_id']">Lihat RPS</a></td></tr></tbody></table></div><div t-else="" class="o_triton_empty"><h2>Belum ada mata kuliah</h2><p>Tidak ada mata kuliah yang cocok dengan pencarian Anda.</p></div></div></section><t t-call="erpobe.triton_footer"/></main></t>
    </template>

</odoo>
