<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="triton_teacher_rps_page" name="RPS Dosen">
        <t t-call="website.layout"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><main class="o_triton_page o_triton_portal-page"><t t-call="erpobe.triton_portal_nav"/><section class="o_triton_section"><div class="o_triton_container"><header class="o_triton_heading"><div><span class="o_triton_eyebrow">Dosen</span><h1>RPS mata kuliah yang diampu</h1><p class="o_triton_subtitle">Aksi hanya tersedia untuk penawaran yang ditugaskan kepada Anda.</p></div></header><div t-if="message" class="o_triton_error" role="alert" t-out="message"/><t t-call="erpobe.triton_portal_list_controls"/><div t-if="lines" class="o_triton_table-wrap"><table class="o_triton_table"><thead><tr><th>Tahun ajaran</th><th>Mata kuliah</th><th>Status RPS</th><th>Bobot</th><th>Aksi</th>        </tr></thead><tbody><t t-foreach="lines" t-as="line"><tr><td><t t-out="line['year']"/> • <t t-out="line['semester']"/></td><td><t t-out="line['code']"/> — <t t-out="line['course']"/></td><td t-out="line['status']"/><td t-out="line['weights']"/><td><form t-if="not line['rps_id']" t-att-action="'/my/rps/%s/create' % line['id']" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="o_triton_btn-ghost" type="submit">Buat RPS</button></form><a t-if="line['rps_id'] and line['status'] != 'final'" class="o_triton_link" t-att-href="'/my/rps/%s/edit' % line['id']">Edit RPS</a><form t-if="line['sources']" t-att-action="'/my/rps/%s/copy' % line['id']" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label class="visually-hidden" t-att-for="'source-%s' % line['id']">Salin RPS final sebelumnya</label><select t-att-id="'source-%s' % line['id']" name="source_rps_id" required="required"><option value="">Pilih RPS final</option><t t-foreach="line['sources']" t-as="source"><option t-att-value="source['id']" t-out="source['name']"/></t></select><button class="o_triton_btn-ghost" type="submit">Salin dari tahun sebelumnya</button></form><form t-if="line['rps_id'] and line['status'] == 'review'" t-att-action="'/my/rps/%s/finalize' % line['rps_id']" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="o_triton_btn" type="submit">Finalisasi</button></form><a t-if="line['rps_id'] and line['status'] == 'final'" class="o_triton_link" t-att-href="'/report/pdf/erpobe.action_report_rps/%s' % line['rps_id']">Cetak RPS</a></td></tr></t></tbody></table></div><div t-else="" class="o_triton_empty"><h2>Belum ada penawaran</h2><p>Tidak ada penawaran yang cocok dengan pencarian atau filter Anda.</p></div></div></section><t t-call="erpobe.triton_footer"/></main></t>
    </template>

</odoo>
