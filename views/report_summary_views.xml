<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_erpobe_summary_mk_list" model="ir.ui.view">
        <field name="name">erpobe.summary.mk.list</field>
        <field name="model">erpobe.summary.mk</field>
        <field name="arch" type="xml">
            <list string="Analisis Mata Kuliah">
                <field name="fakultas_id"/>
                <field name="prodi_id"/>
                <field name="angkatan"/>
                <field name="rombel_id"/>
                <field name="mk_id"/>
                <field name="semester_mk"/>
                <field name="nilai_angka"/>
            </list>
        </field>
    </record>
    <record id="view_erpobe_summary_mk_pivot" model="ir.ui.view">
        <field name="name">erpobe.summary.mk.pivot</field>
        <field name="model">erpobe.summary.mk</field>
        <field name="arch" type="xml">
            <pivot string="Analisis Mata Kuliah">
                <field name="prodi_id" type="row"/>
                <field name="mk_id" type="row"/>
                <field name="angkatan" type="col"/>
                <field name="nilai_angka" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_erpobe_summary_mk_graph" model="ir.ui.view">
        <field name="name">erpobe.summary.mk.graph</field>
        <field name="model">erpobe.summary.mk</field>
        <field name="arch" type="xml">
            <graph string="Rata-rata Nilai Mata Kuliah" type="bar">
                <field name="mk_id"/>
                <field name="nilai_angka" type="measure"/>
            </graph>
        </field>
    </record>
